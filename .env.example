# Copia este archivo a .env.local y completa con tus credenciales de Supabase
# (Project Settings > API en el dashboard de Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para uso en el servidor (API routes / server actions). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Notificaciones push (genera un par nuevo con: npx web-push generate-vapid-keys --json)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BH8Ob...
VAPID_PRIVATE_KEY=Jrw...
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
